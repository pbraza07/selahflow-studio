# Copy to .env.local for local development. Never commit .env.local.
DATABASE_URL=postgresql://salonflow:change-me@localhost:5432/salonflow
ADMIN_EMAIL=owner@example.com
# Replace with your own unique password of at least 6 characters.
ADMIN_PASSWORD=
# Local origin. On Render omit this to use RENDER_EXTERNAL_URL automatically.
# For a custom domain set APP_URL to its full HTTPS origin, without a trailing path.
APP_URL=http://localhost:3000
# Optional: true for an external PostgreSQL endpoint requiring verified TLS.
DATABASE_SSL=false
# Shared Gmail sender (optional local setup). Never commit real credentials.
EMAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Unique random 32-byte encryption key, encoded as 64 hex characters.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Optional additional approved test addresses for staging business communications only.
# Existing STAGING_NOTIFICATION_EMAILS and the global staging enablement still apply.
STAGING_COMMUNICATION_EMAILS=

# SelahFlow software packages: platform-owned monthly Stripe prices and separate webhook.
# Use sandbox values only in staging. Never commit real signing secrets or API keys.
STRIPE_PLATFORM_PRICE_PROFESSIONAL=
STRIPE_PLATFORM_PRICE_BUSINESS=
STRIPE_PLATFORM_WEBHOOK_SECRET=
